            <option>Network Setup & Configuration</option>
            <option>Cloud Deployment & Management</option>
            <option>Cybersecurity & Security Audit</option>
            <option>Remote IT Support</option>
            <option>Database Design & Management</option>
            <option>Workflow Automation</option>
            <option>IT Consulting & Digital Transformation</option>
