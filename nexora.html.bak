<script>
  // ---- Intro sequence control ----
  const intro = document.getElementById('intro');
  const skipBtn = document.getElementById('skipBtn');
  const replayBtn = document.getElementById('replayBtn');

  function endIntro(){ intro.classList.add('hide'); }
  function startIntro(){
    intro.classList.remove('hide');
    // restart animations
    intro.querySelectorAll('*').forEach(el=>{
      const clone = el; // trigger reflow-based restart via class toggle
    });
    void intro.offsetWidth; // reflow
    const doorLeaf = intro.querySelector('.door-leaf');
    const figure = intro.querySelector('.figure');
    const arm = intro.querySelector('.arm-point');
    const spill = intro.querySelector('.light-spill');
    const ray = intro.querySelector('.ray');
    const lines = intro.querySelectorAll('.caption .line, .caption .sub');
    [doorLeaf, figure, arm, spill, ray, ...lines].forEach(el=>{
      el.style.animation = 'none';
      void el.offsetWidth;
      el.style.animation = '';
    });
    clearTimeout(window.__introTimer);
    window.__introTimer = setTimeout(endIntro, 4600);
  }

  skipBtn.addEventListener('click', endIntro);
  replayBtn.addEventListener('click', startIntro);

  // Auto end after the sequence finishes (~4.6s)
  window.__introTimer = setTimeout(endIntro, 4600);

  // Skip immediately if user already saw it this session (still shows briefly, but we can skip entirely)
  if (sessionStorage.getItem('nexora_intro_seen')) {
    intro.classList.add('hide');
  } else {
    sessionStorage.setItem('nexora_intro_seen', '1');
  }

  // ---- Plan prefill for contact form ----
  function prefillPlan(serviceName){
    const select = document.getElementById('fservice');
    for (const opt of select.options){
      if (opt.value === serviceName || opt.text === serviceName){ select.value = opt.value; break; }
    }
  }

  // ---- Contact form -> mailto ----
  document.getElementById('contactForm').addEventListener('submit', function(e){
    e.preventDefault();
    const name = document.getElementById('fname').value.trim();
    const email = document.getElementById('femail').value.trim();
    const service = document.getElementById('fservice').value;
    const message = document.getElementById('fmessage').value.trim();

    const subject = encodeURIComponent(`New inquiry: ${service} — from ${name}`);
    const body = encodeURIComponent(
      `Name: ${name}\nEmail: ${email}\nService: ${service}\n\nMessage:\n${message}`
    );
    const mailto = `mailto:formrule64@gmail.com?subject=${subject}&body=${body}`;

    window.location.href = mailto;

    const status = document.getElementById('form-status');
    status.textContent = 'Opening your email app with the message pre-filled — hit send there to reach us.';
  });

  // ---- Subtle 3D tilt on plan cards ----
  document.querySelectorAll('.plan-card').forEach(card=>{
    card.addEventListener('mousemove', (e)=>{
      const r = card.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - 0.5;
      const y = (e.clientY - r.top) / r.height - 0.5;
      card.style.transform = `rotateY(${x*6}deg) rotateX(${-y*6}deg) translateY(-4px)`;
    });
    card.addEventListener('mouseleave', ()=>{
      card.style.transform = 'rotateY(0) rotateX(0) translateY(0)';
    });
  });
</script>
</body>
</html>