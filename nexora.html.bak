<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Nexora — Innovate. Build. Elevate.</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#05070d;
    --panel:#0b1120;
    --panel-2:#101a30;
    --panel-3:#141f38;
    --line: rgba(140,170,220,0.14);
    --blue-deep:#0e2a6b;
    --blue-1:#1a4fd6;
    --blue-2:#3b7cf0;
    --blue-3:#6fa8ff;
    --ice:#bcd8ff;
    --white:#f3f7ff;
    --muted:#7f93b8;
    --muted-2:#59688a;
    --gold:#ffb454;
    --radius: 18px;
    --ease: cubic-bezier(.16,.84,.44,1);
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--bg);
    color:var(--white);
    font-family:'Inter',sans-serif;
    overflow-x:hidden;
    -webkit-font-smoothing:antialiased;
  }
  ::selection{background:var(--blue-2);color:#fff;}
  h1,h2,h3,.display{font-family:'Space Grotesk',sans-serif;}
  .mono{font-family:'JetBrains Mono',monospace;}
  a{color:inherit;text-decoration:none;}
  ul{list-style:none;}
  img,svg{display:block;max-width:100%;}
  button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit;}

  /* ================= BACKDROP ================= */
  .bg-grid{
    position:fixed;inset:0;z-index:0;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 90% 60% at 50% 0%, #000 30%, transparent 90%);
    opacity:.5;
    pointer-events:none;
  }
  .bg-glow{
    position:fixed;inset:0;z-index:0;pointer-events:none;
    background:
      radial-gradient(600px 400px at 15% 8%, rgba(59,124,240,.20), transparent 60%),
      radial-gradient(500px 380px at 85% 30%, rgba(111,168,255,.14), transparent 60%);
  }

  /* ================= INTRO OVERLAY ================= */
  #intro{
    position:fixed;inset:0;z-index:999;
    background: radial-gradient(120% 120% at 50% 40%, #0a1226 0%, #05070d 70%);
    display:flex;align-items:center;justify-content:center;
    overflow:hidden;
    transition: opacity 1s var(--ease), visibility 1s var(--ease);
  }
  #intro.hide{opacity:0;visibility:hidden;pointer-events:none;}
  #intro .stage{
    position:relative;width:min(560px, 86vw);aspect-ratio:1/1;
  }
  #intro .skip{
    position:absolute;bottom:34px;right:34px;z-index:5;
    font-size:12px;letter-spacing:.14em;text-transform:uppercase;
    color:var(--muted);border:1px solid var(--line);padding:10px 16px;
    border-radius:100px;transition:all .25s var(--ease);
    background:rgba(255,255,255,.02);
  }
  #intro .skip:hover{color:var(--white);border-color:var(--blue-2);background:rgba(59,124,240,.1);}
  #intro .caption{
    position:absolute;left:50%;bottom:14%;transform:translateX(-50%);
    text-align:center;width:100%;
  }
  #intro .caption .line{
    font-size:clamp(20px,3vw,30px);font-weight:600;letter-spacing:.01em;
    opacity:0;color:var(--white);
    animation: revealLine .7s var(--ease) forwards;
  }
  #intro .caption .sub{
    margin-top:8px;font-size:13px;color:var(--muted);letter-spacing:.08em;text-transform:uppercase;
    opacity:0; animation: revealLine .7s var(--ease) forwards;
  }
  @keyframes revealLine{ from{opacity:0; transform:translateY(10px);} to{opacity:1; transform:translateY(0);} }

  /* door frame */
  .door-frame{
    position:absolute; left:50%; top:46%; transform:translate(-50%,-50%);
    width:220px; height:320px; perspective:900px;
  }
  .door-jamb{
    position:absolute; inset:-10px;
    border:2px solid var(--blue-3); border-radius:6px 6px 2px 2px;
    opacity:.55; box-shadow:0 0 40px rgba(111,168,255,.25);
  }
  .door-leaf{
    position:absolute; inset:0; transform-origin:left center;
    background: linear-gradient(135deg,#12234a 0%, #0a1630 55%, #060b18 100%);
    border-radius:4px;
    box-shadow: inset 0 0 0 1px rgba(111,168,255,.25), 0 20px 60px rgba(0,0,0,.6);
    animation: doorOpen 1.6s .5s var(--ease) forwards;
  }
  .door-leaf::before{
    content:'';position:absolute; inset:14px;
    border:1px solid rgba(111,168,255,.18); border-radius:2px;
  }
  .door-knob{
    position:absolute; right:16px; top:50%; width:8px;height:8px; border-radius:50%;
    background:var(--blue-3); box-shadow:0 0 10px var(--blue-3);
  }
  @keyframes doorOpen{
    0%{ transform:rotateY(0deg); }
    100%{ transform:rotateY(-108deg); }
  }
  .light-spill{
    position:absolute; inset:0; border-radius:4px;
    background:linear-gradient(90deg, rgba(111,168,255,.55), transparent 70%);
    opacity:0; animation: spill 1.4s 1.1s var(--ease) forwards;
  }
  @keyframes spill{ 0%{opacity:0;} 40%{opacity:.9;} 100%{opacity:0;} }

  /* low-poly figure */
  .figure{
    position:absolute; left:50%; bottom:6%; width:120px; height:200px;
    transform: translate(-160px, 0) scale(.92);
    opacity:0;
    animation: walkIn 1.1s 1.35s var(--ease) forwards;
  }
  @keyframes walkIn{
    0%{ opacity:0; transform:translate(-160px,0) scale(.92); }
    30%{ opacity:1; }
    100%{ opacity:1; transform:translate(-60px,0) scale(1); }
  }
  .figure svg{ width:100%; height:100%; overflow:visible; }
  .arm-point{
    transform-origin: 46px 92px;
    animation: pointArm .6s 2.5s var(--ease) forwards;
  }
  @keyframes pointArm{
    0%{ transform:rotate(58deg); }
    100%{ transform:rotate(-6deg); }
  }
  .figure .head{ animation: headBob 2.4s 2.5s var(--ease) infinite; transform-origin:60px 30px; }
  @keyframes headBob{ 0%,100%{transform:rotate(0deg);} 50%{transform:rotate(-3deg);} }

  .ray{
    position:absolute; left:50%; bottom:16%;
    width:2px; height:0; background:linear-gradient(180deg, var(--blue-3), transparent);
    transform: translate(90px,-4px) rotate(64deg);
    transform-origin: top;
    opacity:0; animation: rayShoot .5s 2.9s var(--ease) forwards;
  }
  @keyframes rayShoot{ 0%{height:0; opacity:0;} 30%{opacity:1;} 100%{height:220px; opacity:.5;} }

  /* ================= NAV ================= */
  header{
    position:fixed; top:0; left:0; right:0; z-index:100;
    display:flex; align-items:center; justify-content:space-between;
    padding:20px clamp(20px,5vw,64px);
    background:rgba(5,7,13,.55);
    backdrop-filter: blur(14px);
    border-bottom:1px solid var(--line);
  }
  .brand{display:flex;align-items:center;gap:10px;font-weight:700;font-size:19px;letter-spacing:.02em;}
  .brand .mark{width:30px;height:30px;}
  .brand .mark svg{width:100%;height:100%;}
  .brand small{display:block;font-size:9px;color:var(--muted);letter-spacing:.22em;font-weight:500;margin-top:1px;}
  nav ul{display:flex;gap:36px;}
  nav a{
    font-size:14px;font-weight:500;color:var(--muted); position:relative; padding:4px 0;
    transition:color .25s;
  }
  nav a::after{
    content:'';position:absolute;left:0;bottom:0;width:0;height:1px;background:var(--blue-3);
    transition:width .3s var(--ease);
  }
  nav a:hover{color:var(--white);}
  nav a:hover::after{width:100%;}
  .nav-right{display:flex;align-items:center;gap:18px;}
  .btn{
    display:inline-flex;align-items:center;gap:8px;
    padding:11px 22px;border-radius:100px;font-size:13.5px;font-weight:600;
    transition:all .3s var(--ease);
  }
  .btn-primary{
    background:linear-gradient(135deg, var(--blue-2), var(--blue-deep));
    color:#fff; box-shadow:0 8px 24px rgba(26,79,214,.35), inset 0 1px 0 rgba(255,255,255,.2);
  }
  .btn-primary:hover{ transform:translateY(-2px); box-shadow:0 12px 30px rgba(26,79,214,.5); }
  .btn-ghost{ border:1px solid var(--line); color:var(--white); background:rgba(255,255,255,.02); }
  .btn-ghost:hover{ border-color:var(--blue-2); background:rgba(59,124,240,.08); }
  .btn-wa{
    background:rgba(37,211,102,.12); color:#63e08a; border:1px solid rgba(99,224,138,.3);
  }
  .btn-wa:hover{ background:rgba(37,211,102,.2); transform:translateY(-2px); }
  .menu-toggle{display:none;}

  section{ position:relative; z-index:1; padding:140px clamp(20px,6vw,64px); }

  /* ================= HERO ================= */
  #home{ min-height:100vh; display:flex; align-items:center; padding-top:110px; }
  .hero-grid{
    display:grid; grid-template-columns:1.05fr .95fr; gap:60px; align-items:center; width:100%;
    max-width:1320px; margin:0 auto;
  }
  .eyebrow{
    display:inline-flex; align-items:center; gap:8px;
    font-size:12px; letter-spacing:.16em; text-transform:uppercase; color:var(--blue-3);
    border:1px solid rgba(111,168,255,.25); padding:7px 14px; border-radius:100px;
    background:rgba(59,124,240,.06); margin-bottom:26px;
  }
  .eyebrow .dot{width:6px;height:6px;border-radius:50%;background:var(--blue-3); box-shadow:0 0 8px var(--blue-3);}
  h1.hero-title{
    font-size:clamp(38px,5.4vw,68px); line-height:1.04; font-weight:700; letter-spacing:-.02em;
  }
  h1.hero-title .grad{
    background:linear-gradient(100deg, var(--blue-3), var(--blue-1) 60%, var(--blue-3));
    -webkit-background-clip:text; background-clip:text; color:transparent;
  }
  .hero-sub{ margin-top:26px; font-size:17px; line-height:1.7; color:var(--muted); max-width:520px; }
  .hero-cta{ display:flex; gap:16px; margin-top:38px; flex-wrap:wrap; }
  .hero-stats{ display:flex; gap:40px; margin-top:56px; }
  .hero-stats .stat b{ font-family:'Space Grotesk',sans-serif; font-size:26px; display:block; }
  .hero-stats .stat span{ font-size:12.5px; color:var(--muted-2); letter-spacing:.04em; }

  /* 3D mock window */
  .hero-visual{ perspective:1400px; }
  .mock-wrap{ position:relative; width:100%; max-width:480px; margin-left:auto; }
  .mock{
    position:relative; width:100%;
    background:linear-gradient(160deg, var(--panel-2), var(--panel));
    border:1px solid var(--line); border-radius:20px;
    box-shadow: 0 40px 90px rgba(0,0,0,.55), inset 0 1px 0 rgba(255,255,255,.05);
    transform: rotateY(-14deg) rotateX(6deg);
    transition: transform .4s var(--ease);
    overflow:hidden;
  }
  .hero-visual:hover .mock{ transform: rotateY(-6deg) rotateX(2deg); }
  .mock-bar{ display:flex; align-items:center; gap:6px; padding:14px 16px; border-bottom:1px solid var(--line); }
  .mock-bar span{ width:9px;height:9px;border-radius:50%; background:var(--panel-3); }
  .mock-bar .mock-url{
    margin-left:10px; font-size:11px; color:var(--muted-2); font-family:'JetBrains Mono',monospace;
    background:rgba(0,0,0,.25); padding:4px 10px; border-radius:6px; letter-spacing:.02em;
  }
  .mock-body{ padding:26px; }
  .mock-heading{ font-size:15px; font-weight:600; color:var(--white); margin-bottom:6px; }
  .mock-sub{ font-size:12.5px; color:var(--muted); margin-bottom:22px; }
  .mock-cards{ display:grid; grid-template-columns:1fr 1fr; gap:12px; }
  .mock-card{
    height:84px; border-radius:12px; background:linear-gradient(150deg, var(--panel-3), rgba(16,26,48,.6));
    border:1px solid var(--line); position:relative; overflow:hidden;
    display:flex; flex-direction:column; justify-content:center; gap:6px; padding:0 16px;
  }
  .mock-card::after{
    content:''; position:absolute; inset:0;
    background:linear-gradient(120deg, transparent 30%, rgba(111,168,255,.22) 50%, transparent 70%);
    background-size:220% 100%;
    animation: shimmer 3.4s linear infinite;
    pointer-events:none;
  }
  .mock-card .mc-ico{ font-size:16px; }
  .mock-card .mc-label{ font-size:12.5px; font-weight:600; color:var(--white); position:relative; z-index:1; }
  .mock-card .mc-sub{ font-size:10.5px; color:var(--muted-2); position:relative; z-index:1; }
  @keyframes shimmer{ 0%{background-position:130% 0;} 100%{background-position:-30% 0;} }
  .float-badge{
    position:absolute; padding:10px 14px; border-radius:12px; font-size:12.5px; font-weight:600;
    background:rgba(11,17,32,.94); border:1px solid var(--line); backdrop-filter:blur(8px);
    box-shadow:0 14px 30px rgba(0,0,0,.5); display:flex; align-items:center; gap:8px;
    animation: floaty 4.5s ease-in-out infinite; white-space:nowrap; z-index:2;
  }
  .float-badge.b1{ top:-16px; left:8px; animation-delay:0s; }
  .float-badge.b2{ bottom:-16px; right:8px; animation-delay:1.2s; }
  .float-badge .ico{width:16px;height:16px;border-radius:5px;background:linear-gradient(135deg,var(--blue-2),var(--blue-deep)); flex-shrink:0;}
  @keyframes floaty{ 0%,100%{ transform:translateY(0);} 50%{ transform:translateY(-10px);} }

  /* ================= SECTION HEADERS ================= */
  .sec-head{ max-width:640px; margin-bottom:56px; }
  .sec-head .eyebrow{ margin-bottom:18px; }
  .sec-head h2{ font-size:clamp(30px,3.6vw,44px); font-weight:700; letter-spacing:-.015em; line-height:1.12; }
  .sec-head p{ margin-top:16px; color:var(--muted); font-size:16px; line-height:1.7; }

  /* ================= PLANS ================= */
  #plans{ background:linear-gradient(180deg, transparent, rgba(11,17,32,.5) 8%, rgba(11,17,32,.5) 92%, transparent); }
  .plans-grid{
    display:grid; grid-template-columns:repeat(auto-fit,minmax(340px,1fr)); gap:26px;
    max-width:1320px; margin:0 auto;
  }
  .plan-card{
    position:relative; padding:32px 28px; border-radius:var(--radius);
    background:linear-gradient(160deg, var(--panel-2) 0%, var(--panel) 100%);
    border:1px solid var(--line);
    transform-style:preserve-3d; transition:transform .35s var(--ease), border-color .35s, box-shadow .35s;
    display:flex; flex-direction:column;
  }
  .plan-card:hover{
    border-color:rgba(111,168,255,.4);
    box-shadow:0 30px 60px rgba(3,8,20,.6), 0 0 0 1px rgba(111,168,255,.12);
  }
  .plan-icon{
    width:52px;height:52px;border-radius:14px;
    background:linear-gradient(135deg, var(--blue-2), var(--blue-deep));
    display:flex;align-items:center;justify-content:center;font-size:22px;
    box-shadow:0 10px 24px rgba(26,79,214,.35), inset 0 1px 0 rgba(255,255,255,.25);
    margin-bottom:20px;
  }
  .plan-card h3{ font-size:20px; font-weight:700; margin-bottom:10px; letter-spacing:-.01em; }
  .plan-card > p.desc{ color:var(--muted); font-size:14.5px; line-height:1.65; margin-bottom:20px; }
  .plan-card .includes{ margin-bottom:20px; }
  .plan-card .includes-label{ font-size:11px; letter-spacing:.12em; text-transform:uppercase; color:var(--muted-2); margin-bottom:10px; }
  .chip-row{ display:flex; flex-wrap:wrap; gap:7px; }
  .chip{
    font-size:12px; padding:6px 11px; border-radius:100px; background:rgba(111,168,255,.07);
    border:1px solid rgba(111,168,255,.16); color:var(--ice); white-space:nowrap;
  }
  .plan-meta{
    display:grid; grid-template-columns:1fr 1fr; gap:12px; margin:20px 0;
    padding:16px; background:rgba(0,0,0,.18); border-radius:12px; border:1px solid var(--line);
  }
  .plan-meta .m-label{ font-size:10.5px; color:var(--muted-2); letter-spacing:.08em; text-transform:uppercase; }
  .plan-meta .m-val{ font-size:13px; font-weight:600; margin-top:3px; color:var(--white); }
  .plan-tech{ font-size:12.5px; color:var(--muted); margin-bottom:20px; line-height:1.6; }
  .plan-tech b{ color:var(--ice); font-weight:600; }
  .plan-foot{ margin-top:auto; display:flex; align-items:center; justify-content:space-between; gap:14px; padding-top:16px; border-top:1px solid var(--line); }
  .plan-price{ font-family:'Space Grotesk',sans-serif; }
  .plan-price .from{ display:block; font-size:10.5px; color:var(--muted-2); letter-spacing:.08em; text-transform:uppercase; }
  .plan-price .amount{ font-size:22px; font-weight:700; color:var(--white); }
  .plan-cta{
    font-size:13px; font-weight:600; color:var(--blue-3); display:flex; align-items:center; gap:6px;
    padding:10px 16px; border-radius:100px; border:1px solid rgba(111,168,255,.28); white-space:nowrap;
    transition:all .3s var(--ease);
  }
  .plan-cta:hover{ background:rgba(111,168,255,.12); border-color:var(--blue-3); transform:translateX(2px); }

  /* ================= PROJECTS DONE ================= */
  #projects{ background:linear-gradient(180deg, transparent, rgba(11,17,32,.5) 8%, rgba(11,17,32,.5) 92%, transparent); }
  .projects-grid{
    display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:26px;
    max-width:1320px; margin:0 auto;
  }
  .project-card{
    position:relative; padding:28px 24px; border-radius:var(--radius);
    background:linear-gradient(160deg, var(--panel-2) 0%, var(--panel) 100%);
    border:1px solid var(--line); display:flex; flex-direction:column; gap:16px;
    transition:transform .35s var(--ease), border-color .35s, box-shadow .35s;
  }
  .project-card:hover{
    border-color:rgba(111,168,255,.4);
    box-shadow:0 28px 54px rgba(3,8,20,.5), 0 0 0 1px rgba(111,168,255,.12);
    transform:translateY(-3px);
  }
  .project-icon{
    width:52px;height:52px;border-radius:14px;
    background:linear-gradient(135deg, var(--blue-2), var(--blue-deep));
    display:flex;align-items:center;justify-content:center;font-size:22px;
    box-shadow:0 10px 24px rgba(26,79,214,.35), inset 0 1px 0 rgba(255,255,255,.25);
  }
  .project-tag{ font-size:11px; letter-spacing:.12em; text-transform:uppercase; color:var(--blue-3); }
  .project-card h3{ font-size:26px; font-weight:700; letter-spacing:-.015em; }
  .project-card p{ color:var(--muted); font-size:14.5px; line-height:1.7; }
  .project-link{
    margin-top:auto; display:inline-flex; align-items:center; gap:8px;
    font-size:13px; font-weight:600; color:var(--blue-3); padding-top:14px; border-top:1px solid var(--line);
  }

  /* ================= ABOUT ================= */
  .about-grid{ display:grid; grid-template-columns:.9fr 1.1fr; gap:70px; max-width:1320px; margin:0 auto; align-items:start; }
  .about-visual{
    position:sticky; top:130px; border-radius:var(--radius);
    background:linear-gradient(150deg, var(--panel-2), var(--panel));
    border:1px solid var(--line); padding:40px; overflow:hidden;
  }
  .about-visual .glyph{ width:64px; height:64px; margin-bottom:26px; }
  .about-visual h3{ font-size:24px; margin-bottom:14px; }
  .about-visual p{ color:var(--muted); font-size:14.5px; line-height:1.7; }
  .about-stats{ display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-top:32px; }
  .about-stats div{ padding:16px; background:rgba(0,0,0,.18); border-radius:12px; border:1px solid var(--line); }
  .about-stats b{ font-family:'Space Grotesk',sans-serif; font-size:24px; display:block; color:var(--blue-3); }
  .about-stats span{ font-size:12px; color:var(--muted); }

  .about-body p{ color:var(--muted); font-size:16px; line-height:1.85; margin-bottom:22px; }
  .about-body p b{ color:var(--white); font-weight:600; }
  .value-list{ margin-top:36px; display:flex; flex-direction:column; gap:22px; }
  .value-item{ display:flex; gap:20px; padding-bottom:22px; border-bottom:1px solid var(--line); }
  .value-item:last-child{ border-bottom:none; }
  .value-num{ font-family:'Space Grotesk',sans-serif; font-size:15px; color:var(--blue-3); min-width:30px; padding-top:2px; }
  .value-item h4{ font-size:17px; margin-bottom:6px; font-weight:600; }
  .value-item p{ font-size:14.5px; color:var(--muted); margin:0; }

  /* ================= CONTACT ================= */
  #contact{ background:radial-gradient(900px 500px at 80% 0%, rgba(59,124,240,.09), transparent 60%); }
  .contact-grid{ display:grid; grid-template-columns:1fr 1fr; gap:50px; max-width:1180px; margin:0 auto; align-items:stretch; }
  .contact-panel{
    background:linear-gradient(160deg, var(--panel-2), var(--panel)); border:1px solid var(--line);
    border-radius:var(--radius); padding:38px;
  }
  .contact-info h3{ font-size:22px; margin-bottom:12px; }
  .contact-info > p{ color:var(--muted); font-size:14.5px; line-height:1.7; margin-bottom:30px; }
  .contact-link{
    display:flex; align-items:center; gap:16px; padding:18px; border-radius:14px;
    background:rgba(0,0,0,.16); border:1px solid var(--line); margin-bottom:14px;
    transition:all .3s var(--ease);
  }
  .contact-link:hover{ border-color:var(--blue-3); transform:translateX(4px); }
  .contact-link .ico{
    width:42px;height:42px;border-radius:11px;display:flex;align-items:center;justify-content:center;
    font-size:18px; flex-shrink:0;
  }
  .ico-mail{ background:rgba(59,124,240,.14); }
  .ico-wa{ background:rgba(37,211,102,.14); }
  .contact-link .txt small{ display:block; font-size:11px; color:var(--muted-2); text-transform:uppercase; letter-spacing:.08em; margin-bottom:3px; }
  .contact-link .txt strong{ font-size:14.5px; font-weight:600; }
  .contact-hours{ margin-top:24px; padding-top:24px; border-top:1px solid var(--line); font-size:13.5px; color:var(--muted); line-height:1.8; }
  .contact-hours b{ color:var(--white); }

  form .f-row{ display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px; }
  .field{ margin-bottom:16px; }
  .field label{ display:block; font-size:12.5px; color:var(--muted); margin-bottom:8px; font-weight:500; }
  .field input, .field select, .field textarea{
    width:100%; padding:13px 15px; border-radius:11px; background:rgba(0,0,0,.2);
    border:1px solid var(--line); color:var(--white); font-family:'Inter',sans-serif; font-size:14px;
    transition:border-color .25s, background .25s;
  }
  .field input:focus, .field select:focus, .field textarea:focus{
    outline:none; border-color:var(--blue-2); background:rgba(0,0,0,.32);
  }
  .field textarea{ resize:vertical; min-height:110px; }
  .field select{ appearance:none; background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='6'><path d='M0 0l5 6 5-6z' fill='%237f93b8'/></svg>"); background-repeat:no-repeat; background-position:right 16px center; }
  .submit-row{ display:flex; align-items:center; gap:16px; margin-top:22px; flex-wrap:wrap; }
  .form-note{ font-size:12.5px; color:var(--muted-2); }
  #form-status{ font-size:13px; margin-top:14px; color:var(--blue-3); min-height:18px; }

  /* ================= FOOTER ================= */
  footer{
    padding:50px clamp(20px,6vw,64px) 34px; border-top:1px solid var(--line);
    display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:20px;
    position:relative; z-index:1;
  }
  footer .fbrand{ display:flex; align-items:center; gap:10px; font-weight:700; }
  footer .fbrand .mark{ width:24px;height:24px; }
  footer p{ font-size:13px; color:var(--muted-2); }
  footer .fright{ display:flex; gap:22px; align-items:center; }
  footer a.replay{ font-size:12.5px; color:var(--muted); border:1px solid var(--line); padding:8px 14px; border-radius:100px; }
  footer a.replay:hover{ color:var(--white); border-color:var(--blue-2); }

  /* ============ responsive ============ */
  @media (max-width:980px){
    nav{ display:none; }
    .nav-right .btn-ghost{ display:none; }
    .hero-grid, .about-grid, .contact-grid{ grid-template-columns:1fr; }
    .hero-visual{ order:-1; }
    .mock{ margin:0 auto; max-width:400px; }
    .about-visual{ position:static; }
    form .f-row{ grid-template-columns:1fr; }
    .hero-stats{ flex-wrap:wrap; gap:24px; }
  }
  @media (max-width:560px){
    section{ padding:96px 18px; }
    .plan-meta{ grid-template-columns:1fr 1fr; }
    header{ padding:16px 18px; }
  }

  @media (prefers-reduced-motion: reduce){
    *{ animation-duration:.01ms !important; animation-iteration-count:1 !important; transition-duration:.01ms !important; }
  }
</style>
</head>
